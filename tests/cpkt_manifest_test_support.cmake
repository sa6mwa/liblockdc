function(lockdc_assert_cpkt_component manifest component expected_version)
    file(READ "${manifest}" content)
    string(JSON release GET "${content}" release_version)
    if(NOT release STREQUAL "0.5.0")
        message(FATAL_ERROR "Unexpected cpkt release: ${release}")
    endif()
    string(JSON count LENGTH "${content}" components)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON name GET "${content}" components ${index} name)
        if(name STREQUAL component)
            string(JSON version GET "${content}" components ${index} version)
            if(NOT version STREQUAL expected_version)
                message(FATAL_ERROR "${component}: ${version} != ${expected_version}")
            endif()
            return()
        endif()
    endforeach()
    message(FATAL_ERROR "Missing cpkt component: ${component}")
endfunction()
