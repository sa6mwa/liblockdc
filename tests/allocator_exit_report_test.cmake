foreach(mode unused-clean default-off-clean default-off-leak disabled-clean pouch-off-clean
             raw-result-clean arena-clean arena-off-clean invalid-custom-clean invalid-custom-off-clean
             alignment-clean clean pouch-clean custom-clean raw-leak
             handoff-clean shared-counter-clean leak custom-leak failed-realloc-leak resized-leak threaded-leak
             public-clean public-leak public-off-clean public-off-leak zero-leak delegated-leak fork-snapshot-leak)
    set(command ${PROBE_COMMAND})
    set(probe_mode "${mode}")
    set(argument)
    if(mode MATCHES "^public-")
        set(command ${PUBLIC_PROBE_COMMAND})
        string(REPLACE "public-" "" probe_mode "${mode}")
        set(argument 1)
        if(mode MATCHES "^public-off-")
            string(REPLACE "off-" "" probe_mode "${probe_mode}")
            set(argument 0)
        endif()
    endif()
    if(NOT mode MATCHES "clean$")
        # These children deliberately leak to verify our report. Keep external
        # leak checking enabled for every clean-shutdown probe and other test.
        set(command "${CMAKE_COMMAND}" -E env
            "ASAN_OPTIONS=detect_leaks=0:allocator_may_return_null=1" ${command})
    endif()
    execute_process(COMMAND ${command} ${probe_mode} ${argument}
        RESULT_VARIABLE rc OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "allocator ${mode} probe failed: ${rc}\n${output}\n${error}")
    endif()
    if(mode MATCHES "clean$" OR mode MATCHES "^default-off-|^public-off-" OR
       mode STREQUAL "custom-leak" OR mode STREQUAL "raw-leak")
        if(error MATCHES "liblockdc allocator:")
            message(FATAL_ERROR "clean allocator reported a leak: ${error}")
        endif()
    else()
        set(bytes 37)
        set(count 1)
        if(mode STREQUAL "resized-leak" OR mode STREQUAL "delegated-leak")
            set(bytes 73)
        endif()
        if(mode STREQUAL "threaded-leak" OR mode STREQUAL "fork-snapshot-leak")
            set(count 4)
            set(bytes 148)
        endif()
        if(mode STREQUAL "public-leak")
            set(bytes 14)
        endif()
        if(mode STREQUAL "zero-leak")
            set(bytes 0)
        endif()
        if(NOT error MATCHES "liblockdc allocator: ${count} live allocations \\(${bytes} bytes\\) at exit")
            message(FATAL_ERROR "missing/incorrect ${mode} exit report: ${error}")
        endif()
    endif()
endforeach()
