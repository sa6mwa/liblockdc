cmake_minimum_required(VERSION 3.21)
find_program(ctest_bin NAMES ctest REQUIRED)
foreach(selection all runtime cross)
    set(filter)
    if(selection STREQUAL "runtime")
        set(filter -LE "lifecycle-host|release-artifact|native-behavior")
    elseif(selection STREQUAL "cross")
        set(filter -L cross-runtime)
    endif()
    execute_process(COMMAND "${ctest_bin}" --test-dir "${LOCKDC_BINARY_DIR}"
        --show-only=json-v1 ${filter}
        RESULT_VARIABLE rc OUTPUT_VARIABLE inventory ERROR_VARIABLE error)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Cannot inspect ${selection} test selection: ${error}")
    endif()
    string(JSON count LENGTH "${inventory}" tests)
    if(count EQUAL 0)
        message(FATAL_ERROR "Empty ${selection} test selection")
    endif()
    math(EXPR last "${count} - 1")
    set(${selection}_tests)
    foreach(index RANGE 0 ${last})
        string(JSON name GET "${inventory}" tests ${index} name)
        if(selection STREQUAL "all")
            string(JSON ${name}_command GET "${inventory}" tests ${index} command)
        endif()
        if(selection STREQUAL "all")
            string(JSON property_count LENGTH "${inventory}" tests ${index} properties)
            math(EXPR last_property "${property_count} - 1")
            set(leak_gate FALSE)
            foreach(property RANGE 0 ${last_property})
                string(JSON property_name GET "${inventory}" tests ${index} properties ${property} name)
                if(property_name STREQUAL "FAIL_REGULAR_EXPRESSION")
                    string(JSON patterns GET "${inventory}" tests ${index} properties ${property} value)
                    if(patterns MATCHES "liblockdc allocator:")
                        set(leak_gate TRUE)
                    endif()
                endif()
            endforeach()
            if(NOT leak_gate)
                message(FATAL_ERROR "Missing allocator exit gate: ${name}")
            endif()
        endif()
        list(APPEND ${selection}_tests "${name}")
    endforeach()
endforeach()

include("${LOCKDC_ROOT}/tests/unit/portability.cmake")
foreach(target lc_unit_pouch lc_unit_outbox lc_unit_collections)
    # The full native table must remain argument-free. Optimized configurations
    # must execute exactly the declared cases, never an accidentally empty list.
    string(JSON command_length LENGTH "${${target}_command}")
    math(EXPR last_argument "${command_length} - 1")
    set(found_binary FALSE)
    set(arguments)
    foreach(index RANGE 0 ${last_argument})
        string(JSON argument GET "${${target}_command}" ${index})
        if(found_binary)
            list(APPEND arguments "${argument}")
        elseif(argument MATCHES "/${target}$")
            set(found_binary TRUE)
        endif()
    endforeach()
    if(NOT found_binary)
        message(FATAL_ERROR "Missing test binary in command for ${target}")
    endif()
    if(LOCKDC_BUILD_TYPE STREQUAL "Release")
        if(NOT arguments OR NOT arguments STREQUAL lc_portability_${target})
            message(FATAL_ERROR "Wrong portability selection for ${target}: ${arguments}")
        endif()
    elseif(arguments)
        message(FATAL_ERROR "Full native behavioral table was filtered: ${target}")
    endif()
endforeach()
foreach(version 15 16 17 18)
    if(postgres_xa_native_test IN_LIST all_tests AND NOT postgres_xa_pg${version}_test IN_LIST all_tests)
        message(FATAL_ERROR "Full native PostgreSQL version matrix lost PG${version}")
    endif()
    if(postgres_xa_pg${version}_test IN_LIST runtime_tests)
        message(FATAL_ERROR "PostgreSQL version matrix repeated after native Debug")
    endif()
endforeach()
foreach(name lc_unit_pouch lc_unit_outbox lc_unit_collections lc_unit_state_retention
        lc_unit_collection_sync lc_unit_mixed_storage lc_unit_pouch_xa lc_unit_xa_borrow
        lc_allocator_exit_probe pouch_compaction_background_test pouch_compaction_small-stack_test)
    if(NOT name IN_LIST runtime_tests OR NOT name IN_LIST cross_tests)
        message(FATAL_ERROR "Required storage/portability regression lost: ${name}")
    endif()
endforeach()

# Check CTest's actual selection, including both root and subdirectory tests.
foreach(name public_api_boundary version_resolution_test devenv_kube_lifecycle_test
        release_package_matrix_targeting_test valgrind_targeting_test)
    if(NOT name IN_LIST all_tests)
        message(FATAL_ERROR "Required host fixture is not registered: ${name}")
    endif()
endforeach()
foreach(name public_api_boundary version_resolution_test devenv_kube_lifecycle_test
        release_package_matrix_targeting_test valgrind_targeting_test
        release_tarball_sdk_test lua_release_package_test release_checksums_stability_test
        install_tree_sdk_test)
    if(name IN_LIST runtime_tests)
        message(FATAL_ERROR "Repeated host/final-artifact test in runtime lane: ${name}")
    endif()
endforeach()
foreach(name lc_unit_outbox lc_unit_pouch lc_unit_pouch_xa lc_unit_xa_borrow
        shared_public_symbol_boundary
        postgres_sdk_test
        lua_core_package_test lua_postgres_package_test postgres_xa_native_test)
    if(name IN_LIST all_tests AND NOT name IN_LIST runtime_tests)
        message(FATAL_ERROR "Required target-dependent check lost: ${name}")
    endif()
endforeach()
