cmake_minimum_required(VERSION 3.21)
find_program(ctest_bin NAMES ctest REQUIRED)
foreach(selection all runtime)
    set(filter)
    if(selection STREQUAL "runtime")
        set(filter -LE "lifecycle-host|release-artifact")
    endif()
    execute_process(COMMAND "${ctest_bin}" --test-dir "${LOCKDC_BINARY_DIR}"
        --show-only=json-v1 ${filter}
        RESULT_VARIABLE rc OUTPUT_VARIABLE inventory ERROR_VARIABLE error)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Cannot inspect ${selection} test selection: ${error}")
    endif()
    string(JSON count LENGTH "${inventory}" tests)
    if(count EQUAL 0)
        message(FATAL_ERROR "Empty ${selection} test selection")
    endif()
    math(EXPR last "${count} - 1")
    set(${selection}_tests)
    foreach(index RANGE 0 ${last})
        string(JSON name GET "${inventory}" tests ${index} name)
        if(selection STREQUAL "all")
            string(JSON property_count LENGTH "${inventory}" tests ${index} properties)
            math(EXPR last_property "${property_count} - 1")
            set(leak_gate FALSE)
            foreach(property RANGE 0 ${last_property})
                string(JSON property_name GET "${inventory}" tests ${index} properties ${property} name)
                if(property_name STREQUAL "FAIL_REGULAR_EXPRESSION")
                    string(JSON patterns GET "${inventory}" tests ${index} properties ${property} value)
                    if(patterns MATCHES "liblockdc allocator:")
                        set(leak_gate TRUE)
                    endif()
                endif()
            endforeach()
            if(NOT leak_gate)
                message(FATAL_ERROR "Missing allocator exit gate: ${name}")
            endif()
        endif()
        list(APPEND ${selection}_tests "${name}")
    endforeach()
endforeach()

# Check CTest's actual selection, including both root and subdirectory tests.
foreach(name public_api_boundary version_resolution_test devenv_kube_lifecycle_test
        release_package_matrix_targeting_test valgrind_targeting_test)
    if(NOT name IN_LIST all_tests)
        message(FATAL_ERROR "Required host fixture is not registered: ${name}")
    endif()
endforeach()
foreach(name public_api_boundary version_resolution_test devenv_kube_lifecycle_test
        release_package_matrix_targeting_test valgrind_targeting_test
        release_tarball_sdk_test lua_release_package_test release_checksums_stability_test
        install_tree_sdk_test)
    if(name IN_LIST runtime_tests)
        message(FATAL_ERROR "Repeated host/final-artifact test in runtime lane: ${name}")
    endif()
endforeach()
foreach(name lc_unit_outbox lc_unit_pouch lc_unit_pouch_xa lc_unit_xa_borrow
        shared_public_symbol_boundary
        postgres_sdk_test
        lua_core_package_test lua_postgres_package_test postgres_xa_native_test)
    if(name IN_LIST all_tests AND NOT name IN_LIST runtime_tests)
        message(FATAL_ERROR "Required target-dependent check lost: ${name}")
    endif()
endforeach()
if(LOCKDC_TARGET_LIBC STREQUAL "gnu")
    foreach(name optional_postgres_dependency_test c_only_configure_test
            cpp_public_header_test deferred_vendored_install_manifest_test
            arch_alias_configure_test pslog_build_modes_test)
        if(name IN_LIST runtime_tests)
            message(FATAL_ERROR "GNU configure fixture repeated after Debug: ${name}")
        endif()
    endforeach()
endif()
if(cpkt_split_sdk_test IN_LIST all_tests)
    if(LOCKDC_TARGET_LIBC STREQUAL "gnu")
        if(cpkt_split_sdk_test IN_LIST runtime_tests)
            message(FATAL_ERROR "GNU dependency SDK fixture repeated after Debug")
        endif()
    elseif(NOT cpkt_split_sdk_test IN_LIST runtime_tests)
        message(FATAL_ERROR "Distinct dependency SDK fixture lost")
    endif()
endif()
