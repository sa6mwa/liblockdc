@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(_lockdc_postgres_prefix "${PACKAGE_PREFIX_DIR}")
find_dependency(lockdc @PROJECT_VERSION@ CONFIG REQUIRED)
find_dependency(CpktPostgres CONFIG REQUIRED)
set(PACKAGE_PREFIX_DIR "${_lockdc_postgres_prefix}")
foreach(variant static shared)
  set(lockdc_postgres_${variant}_FOUND FALSE)
  if(NOT TARGET lockdc::${variant})
    continue()
  endif()
  if(variant STREQUAL "static")
    set(payload "${PACKAGE_PREFIX_DIR}/lib/liblockdc_postgres.a")
    set(provider cpkt::postgres)
    set(kind STATIC)
  else()
    set(payload "${PACKAGE_PREFIX_DIR}/lib/@CMAKE_SHARED_LIBRARY_PREFIX@lockdc_postgres@CMAKE_SHARED_LIBRARY_SUFFIX@")
    set(provider cpkt::postgres_shared)
    set(kind SHARED)
  endif()
  if(EXISTS "${payload}" AND NOT TARGET lockdc::postgres_${variant})
    add_library(lockdc::postgres_${variant} ${kind} IMPORTED)
    set_target_properties(lockdc::postgres_${variant} PROPERTIES
      IMPORTED_LOCATION "${payload}"
      INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include"
      INTERFACE_LINK_LIBRARIES "${provider};lockdc::${variant}")
  endif()
  if(TARGET lockdc::postgres_${variant})
    set(lockdc_postgres_${variant}_FOUND TRUE)
  endif()
endforeach()
check_required_components(lockdc_postgres)
