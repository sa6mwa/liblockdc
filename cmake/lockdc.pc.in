prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: lockdc
Description: lockd client library for C
Version: @PROJECT_VERSION@
Cflags: -I${includedir} -DLONEJSON_WITH_JWT -DLONEJSON_WITH_OIDC
Requires: pslog lonejson libcurl libssh2 openssl libnghttp2 zlib liblql
Libs: -L${libdir} -llockdc
Libs.private: @LOCKDC_PC_PRIVATE_EXTRA_LIBS@
